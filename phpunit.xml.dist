<?xml version="1.0" encoding="UTF-8"?>

<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         backupGlobals="false"
         colors="true"
         failOnWarning="true"
         defaultTestSuite="Archive7z"
         bootstrap="vendor/autoload.php"
>
    <php>
        <ini name="error_reporting" value="-1" />
    </php>

    <testsuites>
        <testsuite name="Archive7z">
            <directory>tests</directory>
            <exclude>tests/KnownIssues</exclude>
        </testsuite>
        <testsuite name="KnownIssues">
            <directory>tests/KnownIssues</directory>
        </testsuite>
    </testsuites>
</phpunit>
