{
    "name": "gemorroj/archive7z",
    "description": "7z cli wrapper",
    "keywords": ["7z","archive","p7zip","7-zip","7zip"],
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Gemorroj"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/process": "^7.4||^8.0",
        "symfony/polyfill-mbstring": "^1.43"
    },
    "require-dev": {
        "ext-mbstring": "*",
        "phpunit/phpunit": "^11.5||^12.5||^13",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3"
    },
    "suggest": {
        "ext-mbstring": "Recommended for the filename fallback encoding: the native mb_detect_encoding recognizes Cyrillic code pages, unlike the polyfill"
    },
    "autoload": {
        "psr-4": {
            "Archive7z\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Archive7z\\Tests\\": "tests/"
        }
    }
}
